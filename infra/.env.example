# Wzór pliku środowiskowego. Skopiuj jako .env obok docker-compose.yml i uzupełnij.
# Plik .env jest w .gitignore i nie może trafić do repozytorium - trzyma hasła.

# --- Domena ------------------------------------------------------------------
# Musi wskazywać na ten serwer, zanim uruchomisz kontenery. Caddy próbuje pobrać
# certyfikat od razu przy starcie i bez poprawnego DNS-u dostanie odmowę.
SITE_DOMAIN=baba-studio.pl

# --- Widoczność w wyszukiwarkach ---------------------------------------------
# Do dnia otwarcia trzymamy stronę poza wynikami. W dniu premiery zmień na "all"
# i podmień frontend/public/robots.txt, potem uruchom ponownie usługę web.
ROBOTS_TAG=noindex, nofollow

# --- Baza danych -------------------------------------------------------------
POSTGRES_DB=babastudio
POSTGRES_USER=babastudio
# Zmień na losowy ciąg. Baza nie jest wystawiona na zewnątrz, ale hasło domyślne
# to hasło znane wszystkim, którzy widzieli to repozytorium.
#
# UWAGA: hasło zostaje zapisane w bazie przy jej PIERWSZYM uruchomieniu i później
# zmiana tej wartości nic nie daje - Postgres czyta ją tylko przy zakładaniu
# katalogu z danymi. Jeśli wolumen już istnieje, obowiązuje stare hasło.
# Więcej w DEPLOY.md, w sekcji o rzeczach, o które łatwo się potknąć.
POSTGRES_PASSWORD=

# --- Panel administracyjny ---------------------------------------------------
# Bez tych dwóch wartości kontenery nie wstaną - i o to chodzi, bo domyślne
# admin/admin z pliku application.yaml nie może pojechać na produkcję.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Poczta wychodząca -------------------------------------------------------
# Bez tych wartości strona DZIAŁA, ale nic nie wysyła. Konkretnie:
#
#   - wiadomości z formularza zapisują się do bazy i widać je w panelu, ale nikt
#     nie dostaje powiadomienia - trzeba pamiętać, żeby tam zaglądać,
#   - nie wychodzi wiadomość powitalna po zapisie do newslettera, a to jedyna
#     droga, którą odnośnik do rezygnacji trafia do zapisanej osoby.
#
# Poczta studia stoi na Google, więc wysyłamy przez Gmaila i na Gmaila.
# Skrzynka aleksandrakurasik@baba-studio.pl jest jednocześnie nadawcą i odbiorcą.
#
# Wszystkie trzy adresy poniżej to ten sam adres - i tak ma być:
CONTACT_TO_EMAIL=aleksandrakurasik@baba-studio.pl
MAIL_FROM=aleksandrakurasik@baba-studio.pl
SMTP_USERNAME=aleksandrakurasik@baba-studio.pl

# WAŻNE: Google wymaga, żeby nadawca (MAIL_FROM) był tym samym adresem, na który
# się logujemy. Wpisanie tu czegokolwiek innego skończy się odrzuceniem wysyłki
# albo cichą podmianą nadawcy przez Google.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# To NIE jest hasło do konta Google, tylko osobne "hasło aplikacji" - szesnaście
# znaków generowanych na myaccount.google.com/apppasswords. Wymaga włączonej
# weryfikacji dwuetapowej. Zwykłe hasło do konta tu nie zadziała, bo Google
# odciął logowanie hasłem do konta z aplikacji zewnętrznych.
#
# Hasło aplikacji da się unieważnić pojedynczo, bez zmiany hasła do konta -
# dlatego jeśli kiedyś wycieknie ten plik, odcina się tylko wysyłkę ze strony.
SMTP_PASSWORD=

# --- Newsletter --------------------------------------------------------------
# Puste wartości nie psują strony: zapisy przechodzą do bazy, ale nie trafiają
# do GetResponse. Panel pokazuje wtedy, że integracja nie jest skonfigurowana.
GETRESPONSE_API_KEY=
GETRESPONSE_CAMPAIGN_ID=

# Po zapisie wychodzi wiadomość powitalna z odnośnikiem do rezygnacji. Adres tego
# odnośnika bierze się z SITE_URL, które docker-compose układa z SITE_DOMAIN -
# nie trzeba go tu ustawiać. Bez działającego SMTP wiadomość nie wyjdzie, a wtedy
# jedyną drogą rezygnacji zostaje prośba mailem do studia.
#
# Po ilu dniach od rezygnacji kasujemy zapis. Do tego czasu jest dowodem na to,
# że zgoda była i kiedy została wycofana. Zero wyłącza sprzątanie.
# NEWSLETTER_UNSUBSCRIBED_RETENTION_DAYS=365

# Sekret adresu zwrotnego z GetResponse. Wpisz długi losowy ciąg, na przykład
# z "openssl rand -hex 24", a potem wklej go do adresu w panelu GetResponse:
#
#     https://baba-studio.pl/api/newsletter/getresponse-callback?secret=TENSEKRET
#
# GetResponse nie podpisuje swoich wywołań i nie uwierzytelnia się w żaden sposób,
# więc adres bez sekretu byłby otwartą furtką do wypisywania dowolnych osób.
# Puste = endpoint odpowiada 404 i nic nie robi.
NEWSLETTER_CALLBACK_SECRET=

# --- Ograniczenie liczby zgłoszeń --------------------------------------------
# Dotyczy formularza kontaktowego i zapisu do newslettera, liczone osobno dla
# każdego adresu. Domyślnie pięć zgłoszeń na dziesięć minut - z zapasem starcza
# osobie, która się rozmyśliła i pisze drugi raz, a zatrzymuje skrypt.
# RATE_LIMIT_MAX_REQUESTS=5
# RATE_LIMIT_WINDOW_MINUTES=10

# --- Rzadziej zmieniane ------------------------------------------------------
# Domyślnie front i backend stoją pod tym samym adresem, więc lista pochodzeń nie
# jest potrzebna. Ustaw tylko, gdy podpinasz inny adres, na przykład podgląd.
# CORS_ALLOWED_ORIGINS=https://baba-studio.pl
