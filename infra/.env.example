# Wzór pliku środowiskowego. Skopiuj jako .env obok docker-compose.yml i uzupełnij.
# Plik .env jest w .gitignore i nie może trafić do repozytorium - trzyma hasła.

# --- Domena ------------------------------------------------------------------
# Musi wskazywać na ten serwer, zanim uruchomisz kontenery. Caddy próbuje pobrać
# certyfikat od razu przy starcie i bez poprawnego DNS-u dostanie odmowę.
SITE_DOMAIN=babapilates.pl

# Adres, na który Let's Encrypt wyśle ostrzeżenie, gdyby odnowienie certyfikatu
# zaczęło się nie udawać. Można zostawić pusty, ale lepiej nie.
ACME_EMAIL=

# --- Widoczność w wyszukiwarkach ---------------------------------------------
# Do dnia otwarcia trzymamy stronę poza wynikami. W dniu premiery zmień na "all"
# i podmień frontend/public/robots.txt, potem uruchom ponownie usługę web.
ROBOTS_TAG=noindex, nofollow

# --- Baza danych -------------------------------------------------------------
POSTGRES_DB=babastudio
POSTGRES_USER=babastudio
# Zmień na losowy ciąg. Baza nie jest wystawiona na zewnątrz, ale hasło domyślne
# to hasło znane wszystkim, którzy widzieli to repozytorium.
POSTGRES_PASSWORD=

# --- Panel administracyjny ---------------------------------------------------
# Bez tych dwóch wartości kontenery nie wstaną - i o to chodzi, bo domyślne
# admin/admin z pliku application.yaml nie może pojechać na produkcję.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Formularz kontaktowy ----------------------------------------------------
# Adres, na który przychodzą wiadomości ze strony. To co innego niż adres
# wyświetlany na stronie - ten drugi siedzi w kodzie, w core/contact-details.ts.
CONTACT_TO_EMAIL=

# Nadawca wiadomości. Zwykle musi należeć do domeny uwierzytelnionej w SMTP,
# inaczej poczta trafi do spamu albo zostanie odrzucona.
MAIL_FROM=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Newsletter --------------------------------------------------------------
# Puste wartości nie psują strony: zapisy przechodzą do bazy, ale nie trafiają
# do GetResponse. Panel pokazuje wtedy, że integracja nie jest skonfigurowana.
GETRESPONSE_API_KEY=
GETRESPONSE_CAMPAIGN_ID=

# --- Rzadziej zmieniane ------------------------------------------------------
# Domyślnie front i backend stoją pod tym samym adresem, więc lista pochodzeń nie
# jest potrzebna. Ustaw tylko, gdy podpinasz inny adres, na przykład podgląd.
# CORS_ALLOWED_ORIGINS=https://babapilates.pl
